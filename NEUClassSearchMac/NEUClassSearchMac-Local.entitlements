<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For local builds without a provisioning profile (e.g. command-line builds signed to run
  locally): the same sandbox as the shipping app, including the Mac plans app group, minus iCloud and push, which need a profile.
  The app shows iCloud sync as "not set up in this build". Xcode builds with your team use
  NEUClassSearchMac.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>832J6JB4V7.com.alexchadwick.termorganize</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
